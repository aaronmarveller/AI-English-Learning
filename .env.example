# Server-only — read exclusively by src/app/api/practice/turn/route.ts.
# Never referenced from a Client Component; never present in the client
# bundle. See ticket 08's DoD: `.next` build output must contain zero
# matches for the `sk-ant-` key prefix.
ANTHROPIC_API_KEY=

# Used only by scripts/generate-audio.ts (ticket 13; `npm run generate:audio`)
# to pre-generate public/audio/*.mp3 for Emily's fixed lines and Explore's
# expressions. Never read at app runtime — the app itself only ever plays
# already-generated files (or falls back to browser speech synthesis when
# they're missing), so leaving these unset doesn't block using or demoing
# the app.
TTS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
