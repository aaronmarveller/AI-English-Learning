# Server-only — read exclusively by src/app/api/realtime/summary/route.ts,
# which writes the Learning Summary. Never referenced from a Client Component;
# never present in the client bundle (the `.next` build output must contain
# zero matches for the `sk-ant-` key prefix).
ANTHROPIC_API_KEY=

# Server-only — read by src/app/api/realtime/session/route.ts, which mints the
# short-lived client secret a Call connects to OpenAI's Realtime API with (the
# browser never sees this key), and by scripts/generate-audio.ts, which
# pre-generates Explore's public/audio/*.mp3.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# scripts/generate-audio.ts only (only "openai" is implemented).
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# "coral" was selected after bilingual English/Chinese listening tests for a
# warm, clear voice. “coral” 经中英文双语试听后选定，声音温暖、清晰。
# Decision record: https://github.com/aaronmarveller/AI-English-Learning/issues/24#issuecomment-5245763238
OPENAI_TTS_VOICE=coral
