# Server-only — read exclusively by src/app/api/practice/turn/route.ts.
# Never referenced from a Client Component; never present in the client
# bundle. See ticket 08's DoD: `.next` build output must contain zero
# matches for the `sk-ant-` key prefix.
ANTHROPIC_API_KEY=

# OPENAI_API_KEY is read by two manual scripts: scripts/generate-audio.ts
# pre-generates public/audio/*.mp3, while scripts/sample-tts-voices.ts creates
# the git-ignored bilingual comparison set. It is also read at runtime by
# src/app/api/practice/speak/route.ts (which synthesizes Emily's live,
# per-turn conversation replies through the same voice on demand, since
# those have no fixed text to pre-generate ahead of time). Leaving it unset
# doesn't block using or demoing the app either way — generate-audio.ts just
# refuses to run, and the live route falls back to browser speech synthesis.
# TTS_PROVIDER selects the provider for both manual scripts (only "openai" is
# implemented); the runtime route always uses OpenAI directly.
TTS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_SAMPLE_MODEL=gpt-4o-mini-tts
# "coral" was selected after bilingual English/Chinese listening tests for a
# warm, clear Emily voice. “coral” 经中英文双语试听后选定，声音温暖、清晰，适合 Emily。
# Decision record: https://github.com/aaronmarveller/AI-English-Learning/issues/24#issuecomment-5245763238
OPENAI_TTS_VOICE=coral
